root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
tab_width = 2

[*.{kt,kts}]
ij_continuation_indent_size = 4
ij_kotlin_continuation_indent_size = 4
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

[*.xml]
ij_xml_continuation_indent_size = 4
